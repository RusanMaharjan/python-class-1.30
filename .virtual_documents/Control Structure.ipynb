# pin
# withdraw amount must be less than availalbe balance
# withdraw amount must be multiple of 1000s.
pin = 1234
balance = 50000

user_pin = int(input('Enter your pin number: '))

if user_pin == pin: # 123 == 1234 -> False
    amount = int(input('Enter your withdraw balance: '))

    if amount < balance: # 5500 < 50000
        if amount % 1000 == 0: # 5500 % 1000 == 0
            print(f'Rs.{amount} has been withdrawn.')
        else:
            print('Withdraw amount must be multiple of 1000.')
    else:
        print('Withdraw amount must be less than available balance.')
else:
    print('Incorrect pin number.')





'''
match variable:
    case '1':
        print(...)
    case '2':
        print(...)
    case _:
        print(...)
'''


print('Welcome to Restaurant Order System')
print('1. Breakfast')
print('2. Snacks')
print('3. Lunch')
print('4. Dinner')
print('5. Dessert')

choice = int(input('Enter your order choice: '))

match choice:
    case 1:
        print('You have ordered breakfast.')
        print('1. Tea')
        print('2. Egg')
        print('3. Bread')

        bf_choice = int(input('Enter your breakfast choice: '))

        match bf_choice:
            case 1:
                print('You have ordered Tea.')
            case 2:
                print('You have ordered Egg.')
            case 3:
                print('You have ordered Bread.')
            case _:
                print('Invalid breakfast choice.')
    case 2:
        print('You have ordered snacks.')
    case 3:
        print('You have orderd lunch.')
    case 4:
        print('You have ordered dinner.')
    case 5:
        print('You have ordered dessert.')
    case _:
        print('Invalid choice.')





'''
- strip() -> used to remove whitespace from text.
    - strip() -> used to remove whitespace from both side of text.
    - lstrip() -> used to remove whitespace from left side of text.
    - rstrip() -> used to remove whitespace from right side of text.

- lower() -> used to convert text to lowercase.
- upper() -> used to convert text to upper case.
- capitalize() -> used to convert initial letter of text to capital letter.

- replace(find, replace)
'''


text = '   asdfghjkl   '
var = text.lstrip()
var


